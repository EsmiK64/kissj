{% extends "pages/_admin-subpage-shell.twig" %}
{% set sectionTitle = 'Programy & Sekce (eventApp)' %}
{% set pageTitle = 'Programy & Sekce – kissj Mockup' %}

{% block pageContent %}
{# 1. Compact Action Bar (keeps Calendar immediately above the fold) #}
<div class="admin-card" style="padding: 16px 22px; margin-bottom: 16px;">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
            <h2 style="margin: 0;">Programy</h2>
            <span class="pill pill-ok"><i class="material-icons">sync</i> eventApp</span>
            <button type="button" class="pill pill-info" id="open-window-modal" style="border: none; cursor: pointer; font-family: inherit;">
                <i class="material-icons">schedule</i> Okno: 1. 5. – 12. 5. (Upravit)
            </button>
        </div>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
            <a href="#new-prog" class="btn btn-small btn-accent"><i class="material-icons">add_circle</i> Vytvořit program</a>
            <a href="#print" class="btn btn-small btn-grey"><i class="material-icons">print</i> Prezenčky PDF</a>
            <a href="#export-csv" class="btn btn-small btn-grey"><i class="material-icons">download</i> Export CSV</a>
            <a href="/alt-1-command-tiles.twig" class="btn btn-small btn-grey" aria-label="Zpět na přehled"><i class="material-icons">arrow_back</i></a>
        </div>
    </div>
</div>

{# 2. View-Switcher Card: Kalendář | Seznam | Sekce #}
<div class="admin-card">
    <div class="prog-tabs">
        <input type="radio" name="prog-view" id="prog-view-cal" checked>
        <input type="radio" name="prog-view" id="prog-view-list">
        <input type="radio" name="prog-view" id="prog-view-sec">

        <div class="prog-view-bar" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px;">
            <div class="role-tab-bar" role="tablist" aria-label="Zobrazení programů" style="margin-bottom: 0;">
                <label for="prog-view-cal" class="role-tab-label"><i class="material-icons" style="font-size: 1rem; vertical-align: middle;">calendar_view_week</i> Kalendář</label>
                <label for="prog-view-list" class="role-tab-label"><i class="material-icons" style="font-size: 1rem; vertical-align: middle;">table_rows</i> Seznam (46)</label>
                <label for="prog-view-sec" class="role-tab-label"><i class="material-icons" style="font-size: 1rem; vertical-align: middle;">category</i> Sekce (5)</label>
            </div>

            {# Interactive Section Filter Pills #}
            <div class="sec-filter-bar" style="display: flex; gap: 6px; flex-wrap: wrap;" aria-label="Filtrovat podle sekce">
                <button type="button" class="pill pill-neutral sec-filter-btn is-active" data-sec-filter="all">Vše</button>
                <button type="button" class="pill pill-ok sec-filter-btn" data-sec-filter="outdoor">Outdoor</button>
                <button type="button" class="pill pill-info sec-filter-btn" data-sec-filter="debaty">Debaty</button>
                <button type="button" class="pill pill-warn sec-filter-btn" data-sec-filter="dilny">Dílny</button>
                <button type="button" class="pill pill-neutral sec-filter-btn" data-sec-filter="povinne">Povinné</button>
            </div>
        </div>

        <div class="prog-view-panels">
            {# ==================== TAB 1: GOOGLE CALENDAR TIMELINE ==================== #}
            <div class="prog-view-panel panel-cal">
                <div class="cal-wrap">
                    <div class="cal-gcal">
                        <div class="cal-gcal-header">
                            <div class="cal-head">Čas</div>
                            <div class="cal-head">Pátek 14. 5.</div>
                            <div class="cal-head">Sobota 15. 5.</div>
                            <div class="cal-head">Neděle 16. 5.</div>
                        </div>
                        <div class="cal-gcal-body">
                            <div class="cal-time-col">
                                {% for h in 8..21 %}
                                    <div class="cal-time-label">{{ '%02d:00'|format(h) }}</div>
                                {% endfor %}
                            </div>

                            {# Pátek 14. 5. #}
                            <div class="cal-day-col">
                                <a href="#quick-edit" class="cal-event cal-sec-dilny" data-start="2027-05-14T15:30" data-end="2027-05-14T17:45" data-place="Hangár" data-cap="20" data-sec="dilny" style="top: calc(7.5 * var(--hour-h)); height: calc(2.25 * var(--hour-h));">
                                    <div class="cal-event-top"><span>Příjezd &amp; dílna</span><span class="cal-occ">14/20</span></div>
                                    <div class="cal-event-meta">15:30 – 17:45 · Hangár</div>
                                    <span class="cal-resize-handle" aria-hidden="true"></span>
                                </a>
                                <a href="#quick-edit" class="cal-event cal-sec-povinne" data-start="2027-05-14T20:00" data-end="2027-05-14T21:30" data-place="Amfiteátr" data-cap="1200" data-sec="povinne" style="top: calc(12 * var(--hour-h)); height: calc(1.5 * var(--hour-h));">
                                    <div class="cal-event-top"><span>Slavnostní zahájení</span><span class="cal-occ">Povinné</span></div>
                                    <div class="cal-event-meta">20:00 – 21:30 · Amfiteátr</div>
                                    <span class="cal-resize-handle" aria-hidden="true"></span>
                                </a>
                            </div>

                            {# Sobota 15. 5. #}
                            <div class="cal-day-col">
                                <a href="#quick-edit" class="cal-event cal-sec-outdoor" data-start="2027-05-15T09:30" data-end="2027-05-15T11:15" data-place="Louka B" data-cap="30" data-sec="outdoor" style="top: calc(1.5 * var(--hour-h)); height: calc(1.75 * var(--hour-h));">
                                    <div class="cal-event-top"><span>Ranní dílna přežití</span><span class="cal-occ">24/30</span></div>
                                    <div class="cal-event-meta">09:30 – 11:15 · Louka B</div>
                                    <span class="cal-resize-handle" aria-hidden="true"></span>
                                </a>
                                <a href="#quick-edit" class="cal-event cal-sec-debaty" data-start="2027-05-15T14:00" data-end="2027-05-15T16:00" data-place="Hlavní stan" data-cap="50" data-sec="debaty" style="top: calc(6 * var(--hour-h)); height: calc(2 * var(--hour-h));">
                                    <div class="cal-event-top"><span>Debata o budoucnosti</span><span class="cal-occ is-over">52/50!</span></div>
                                    <div class="cal-event-meta">14:00 – 16:00 · Stan</div>
                                    <span class="cal-resize-handle" aria-hidden="true"></span>
                                </a>
                                <a href="#quick-edit" class="cal-event cal-sec-dilny" data-start="2027-05-15T14:30" data-end="2027-05-15T17:15" data-place="Dílnový hangár" data-cap="20" data-sec="dilny" style="top: calc(6.5 * var(--hour-h)); height: calc(2.75 * var(--hour-h));">
                                    <div class="cal-event-top"><span>Linoryt a sítotisk</span><span class="cal-occ">20/20</span></div>
                                    <div class="cal-event-meta">14:30 – 17:15 · Hangár</div>
                                    <span class="cal-resize-handle" aria-hidden="true"></span>
                                </a>
                            </div>

                            {# Neděle 16. 5. #}
                            <div class="cal-day-col">
                                <a href="#quick-edit" class="cal-event cal-sec-outdoor" data-start="2027-05-16T09:00" data-end="2027-05-16T11:30" data-place="Celý areál" data-cap="100" data-sec="outdoor" style="top: calc(1 * var(--hour-h)); height: calc(2.5 * var(--hour-h));">
                                    <div class="cal-event-top"><span>Závěrečná hra</span><span class="cal-occ">88/100</span></div>
                                    <div class="cal-event-meta">09:00 – 11:30 · Celý areál</div>
                                    <span class="cal-resize-handle" aria-hidden="true"></span>
                                </a>
                                <a href="#quick-edit" class="cal-event cal-sec-povinne" data-start="2027-05-16T13:00" data-end="2027-05-16T14:15" data-place="Amfiteátr" data-cap="1200" data-sec="povinne" style="top: calc(5 * var(--hour-h)); height: calc(1.25 * var(--hour-h));">
                                    <div class="cal-event-top"><span>Zakončení akce</span><span class="cal-occ">Povinné</span></div>
                                    <div class="cal-event-meta">13:00 – 14:15 · Amfiteátr</div>
                                    <span class="cal-resize-handle" aria-hidden="true"></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="text-small text-muted" style="margin: 10px 0 0;">
                    Tip: Táhněte prázdným místem pro vytvoření bloku, přesouvejte bloky mezi dny/časy nebo táhněte za spodní okraj pro změnu délky.
                </p>
            </div>

            {# ==================== TAB 2: SEZNAM BLOKŮ ==================== #}
            <div class="prog-view-panel panel-list">
                <div class="filter-bar">
                    <input type="search" placeholder="Hledat název programu, místo, lektora…" aria-label="Hledat program">
                    <select aria-label="Sekce">
                        <option value="">Všechny sekce</option>
                        <option value="outdoor">Outdoor &amp; Přežití</option>
                        <option value="debaty">Společenské &amp; Debaty</option>
                        <option value="dilny">Tvořivé dílny</option>
                    </select>
                    <select aria-label="Cílová role">
                        <option value="">Všechny role</option>
                        <option value="pl">PL</option>
                        <option value="pp">PP</option>
                        <option value="ist">IST</option>
                    </select>
                </div>

                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Čas</th><th>Název programu</th><th>Sekce</th><th>Místo</th><th>Obsazenost</th><th>Role</th><th>Akce</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>So 09:30 – 11:15</td><td><b>Ranní dílna přežití</b></td>
                                <td><span class="pill pill-ok">Outdoor</span></td><td>Louka B</td>
                                <td><div class="cap-meter"><div class="cap-track"><div class="cap-fill" style="width: 80%;"></div></div><span>24 / 30</span></div></td>
                                <td>PL, PP</td>
                                <td><a href="#edit" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                            <tr>
                                <td>So 14:00 – 16:00</td><td><b>Debata o budoucnosti</b></td>
                                <td><span class="pill pill-info">Debaty</span></td><td>Hlavní stan</td>
                                <td><div class="cap-meter"><div class="cap-track"><div class="cap-fill is-over" style="width: 100%;"></div></div><span class="pill pill-err">52 / 50</span></div></td>
                                <td>Všichni</td>
                                <td><a href="#edit" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                            <tr>
                                <td>So 14:30 – 17:15</td><td><b>Linoryt a sítotisk</b></td>
                                <td><span class="pill pill-warn">Dílny</span></td><td>Dílnový hangár</td>
                                <td><div class="cap-meter"><div class="cap-track"><div class="cap-fill is-full" style="width: 100%;"></div></div><span>20 / 20</span></div></td>
                                <td>PP, IST</td>
                                <td><a href="#edit" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                            <tr>
                                <td>Pá 20:00 – 21:30</td><td><b>Slavnostní zahájení</b></td>
                                <td><span class="pill pill-neutral">Povinné</span></td><td>Amfiteátr</td>
                                <td><span class="pill pill-info">Předregistrováno</span></td>
                                <td>Všichni</td>
                                <td><a href="#edit" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {# ==================== TAB 3: SEKCE PROGRAMŮ ==================== #}
            <div class="prog-view-panel panel-sec">
                <div class="admin-card-header">
                    <span class="text-muted">Sekce určují kategorie a barvy v kalendáři i v aplikaci eventApp.</span>
                    <button type="button" class="btn btn-small"><i class="material-icons">add</i> Přidat sekci</button>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th>Název sekce</th><th>Bloků</th><th>Kapacita</th><th>Obsazenost</th><th>Viditelnost v eventApp</th><th>Akce</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><b>Outdoor &amp; Přežití</b></td><td>12</td><td>360</td>
                                <td><div class="cap-meter"><div class="cap-track"><div class="cap-fill" style="width: 82%;"></div></div><span>82 %</span></div></td>
                                <td><span class="pill pill-ok">Veřejná</span></td>
                                <td><a href="#edit-sec" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                            <tr>
                                <td><b>Společenské &amp; Debaty</b></td><td>10</td><td>500</td>
                                <td><div class="cap-meter"><div class="cap-track"><div class="cap-fill is-full" style="width: 96%;"></div></div><span>96 %</span></div></td>
                                <td><span class="pill pill-ok">Veřejná</span></td>
                                <td><a href="#edit-sec" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                            <tr>
                                <td><b>Tvořivé dílny</b></td><td>14</td><td>280</td>
                                <td><div class="cap-meter"><div class="cap-track"><div class="cap-fill" style="width: 64%;"></div></div><span>64 %</span></div></td>
                                <td><span class="pill pill-ok">Veřejná</span></td>
                                <td><a href="#edit-sec" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                            <tr>
                                <td><b>Duchovní &amp; Reflexe</b></td><td>6</td><td>180</td>
                                <td><div class="cap-meter"><div class="cap-track"><div class="cap-fill" style="width: 51%;"></div></div><span>51 %</span></div></td>
                                <td><span class="pill pill-ok">Veřejná</span></td>
                                <td><a href="#edit-sec" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                            <tr>
                                <td><b>Povinné / Předregistrované</b></td><td>4</td><td>Bez limitu</td>
                                <td><span class="pill pill-info">Automaticky všem</span></td>
                                <td><span class="pill pill-neutral">Fixní v rozvrhu</span></td>
                                <td><a href="#edit-sec" class="btn btn-mini btn-grey">Upravit</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{# Modal: Vytvořit / Upravit program #}
<dialog id="prog-modal" class="prog-modal" aria-labelledby="prog-modal-title">
    <div class="admin-card-header">
        <div>
            <span class="pill pill-warn" id="prog-modal-badge">Rychlá úprava bloku</span>
            <h3 id="prog-modal-title" style="margin-top: 6px;">Úprava programu</h3>
        </div>
        <button type="button" class="btn btn-small btn-grey" id="prog-modal-close" aria-label="Zavřít">✕</button>
    </div>

    <div style="display: flex; flex-direction: column; gap: 10px;">
        <label class="text-small">Název:
            <input id="prog-modal-name" class="modern-input" type="text" value="" style="width: 100%; margin-top: 4px;">
        </label>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <label class="text-small">Začátek:
                <input id="prog-modal-start" class="modern-input" type="datetime-local" value="" style="width: 100%; margin-top: 4px;">
            </label>
            <label class="text-small">Konec:
                <input id="prog-modal-end" class="modern-input" type="datetime-local" value="" style="width: 100%; margin-top: 4px;">
            </label>
        </div>
        <label class="text-small">Sekce (barva v eventApp):
            <select id="prog-modal-sec" class="modern-select" style="width: 100%; margin-top: 4px;">
                <option value="outdoor">Outdoor &amp; Přežití</option>
                <option value="debaty">Společenské &amp; Debaty</option>
                <option value="dilny">Tvořivé dílny</option>
                <option value="povinne">Povinné / Předregistrované</option>
            </select>
        </label>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <label class="text-small">Místo:
                <input id="prog-modal-place" class="modern-input" type="text" value="" style="width: 100%; margin-top: 4px;">
            </label>
            <label class="text-small">Kapacita:
                <input id="prog-modal-cap" class="modern-input" type="number" value="25" style="width: 100%; margin-top: 4px;">
            </label>
        </div>
    </div>

    <div class="inspector-actions">
        <button type="button" class="btn btn-block btn-accent" id="prog-modal-save"><i class="material-icons">save</i> Uložit změny</button>
        <button type="button" class="btn btn-block btn-grey" id="prog-modal-delete"><i class="material-icons">delete</i> Smazat blok</button>
    </div>
</dialog>

{# Modal: Okno přihlašování #}
<dialog id="window-modal" class="prog-modal" aria-labelledby="window-modal-title">
    <div class="admin-card-header">
        <h3 id="window-modal-title" style="margin: 0;">Přihlašovací okno v eventApp</h3>
        <button type="button" class="btn btn-small btn-grey" id="window-modal-close" aria-label="Zavřít">✕</button>
    </div>
    <div style="display: flex; flex-direction: column; gap: 12px;">
        <label class="text-small">Otevření přihlašování:
            <input class="modern-input" type="datetime-local" value="2027-05-01T18:00" style="width: 100%; margin-top: 4px;">
        </label>
        <label class="text-small">Uzavření přihlašování:
            <input class="modern-input" type="datetime-local" value="2027-05-12T23:59" style="width: 100%; margin-top: 4px;">
        </label>
        <button type="button" class="btn btn-block btn-accent" id="window-modal-save"><i class="material-icons">save</i> Uložit okno</button>
    </div>
</dialog>
{% endblock %}
